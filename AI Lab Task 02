print("\nTASK 3: MODE-AWARE CONTROLLER")


class ModeAwareController:

    def __init__(self):
        self.previous_mode = None
        self.previous_command = None
        self.previous_target = None

    def control(self, temperature, target):

        if temperature >= 30:
            mode = "COOL"

        elif temperature <= 18:
            mode = "HEAT"

        elif self.previous_mode is not None:
            mode = self.previous_mode

        else:
            mode = "IDLE"

        if mode == "IDLE":
            command = "IDLE"
        else:
            command = mode + ":" + target

        # Avoid repeating identical commands
        if (command == self.previous_command
                and target == self.previous_target
                and mode == self.previous_mode):

            print("Same command - Not Sent")

        else:
            print("Temperature:", temperature)
            print("Mode:", mode)
            print("Target:", target)
            print("Command Sent:", command)

        self.previous_mode = mode
        self.previous_command = command
        self.previous_target = target


# Testing Controller

controller = ModeAwareController()

print("\nController Test Results:")

controller.control(30, "Room-A")
